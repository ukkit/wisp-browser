
/** ------------------------------
 * [WISP] Wisp overlay additions
 * appended after LibreWolf's own librewolf.cfg content — see wisp-v1-build-plan.md Task 4.
 * ------------------------------- */

/** LibreWolf only `defaultPref`s these two — Wisp locks them so users/extensions/policies can't flip them back. */
lockPref("privacy.resistFingerprinting", true);
lockPref("dom.security.https_only_mode", true);

/** First-Party Isolation: partitions cookies, cache, HSTS state, localStorage, IndexedDB, and all
 * other browser state by the top-level (first-party) domain. Extends ETP strict's Total Cookie
 * Protection (which covers third-party cookies) to also cover cache-timing and HSTS supercookie
 * vectors that TCP misses. Trade-off: breaks cross-origin SSO and some OAuth flows.
 */
lockPref("privacy.firstparty.isolate", true);

/** LibreWolf sets these two via plain `pref()` (not even `defaultPref`), not locked at all. Both are
 * central to Wisp's ad-tech/cross-site-tracker threat model, found during a hardening audit pass:
 * - contentblocking.category "strict" is the master ETP switch (third-party cookie blocking, strict
 *   tracker lists, dFPI) — flippable back to "standard" via Settings UI or about:config otherwise.
 * - private-attribution is Mozilla's built-in ad-measurement/attribution API (their answer to FLoC).
 */
lockPref("browser.contentblocking.category", "strict");
lockPref("dom.private-attribution.submission.enabled", false);

/** Always-on Private Browsing: no persistent history/cookies/cache/form data across restarts.
 * LibreWolf ships this off (plain pref(), not locked) and deliberately hides the related Settings
 * UI toggle since it forces "custom" history mode for everyone regardless — see the upstream
 * comment above privacy.history.custom in librewolf.cfg. Doesn't affect bookmarks, downloads, or
 * saved passwords, which Private Browsing mode never blocks.
 */
lockPref("browser.privatebrowsing.autostart", true);

/** Re-declare the full DoH provider list with a "Mullvad (Base)" entry added, so the Settings UI
 * dropdown shows the correct name for the endpoint the DNSOverHTTPS policy sets as default.
 * This is a full re-declaration, not an append — defaultPref() replaces the whole value, and the
 * later defaultPref() call wins over LibreWolf's own earlier one for the same pref.
 */
defaultPref(
  "doh-rollout.provider-list",
  `[
  {
    "UIName": "Quad9 (No Filtering)",
    "uri": "https://dns10.quad9.net/dns-query"
  },
  {
    "UIName": "Quad9 (Malware blocking)",
    "uri": "https://dns.quad9.net/dns-query"
  },
  {
    "UIName": "LibreDNS (No Filtering)",
    "uri": "https://doh.libredns.gr/dns-query"
  },
  {
    "UIName": "LibreDNS (Adblocking)",
    "uri": "https://doh.libredns.gr/noads"
  },
  {
    "UIName": "Wikimedia DNS (No Filtering)",
    "uri": "https://wikimedia-dns.org/dns-query"
  },
  {
    "UIName": "DNS4All (No Filtering)",
    "uri": "https://doh.dns4all.eu/dns-query"
  },
  {
    "UIName": "Mullvad (No Filtering)",
    "uri": "https://dns.mullvad.net/dns-query"
  },
  {
    "UIName": "Mullvad (Base)",
    "uri": "https://base.dns.mullvad.net/dns-query"
  }
]`
);

/** Repoint Help/About/update URLs at the wisp-browser repo instead of LibreWolf's own site/tracker —
 * matches the SupportMenu repoint in distribution/policies.json.
 */
defaultPref("app.support.baseURL", "https://github.com/ukkit/wisp-browser");
defaultPref("app.feedback.baseURL", "https://github.com/ukkit/wisp-browser/issues");
defaultPref("app.releaseNotesURL", "https://github.com/ukkit/wisp-browser/releases");
defaultPref("app.releaseNotesURL.aboutDialog", "https://github.com/ukkit/wisp-browser/releases");
defaultPref("app.update.url.details", "https://github.com/ukkit/wisp-browser/releases");
defaultPref("app.update.url.manual", "https://github.com/ukkit/wisp-browser/releases");

/** Explicitly place all 4 bundled extensions in the nav-bar on a fresh profile.
 * The policy default_area:"navbar" only works for extensions whose manifest already
 * declares default_area — Bitwarden and Clear Cache don't, so they fall to
 * unified-extensions-area. Bundled XPIs ensure all widgets are registered before
 * CustomizableUI initialises, so this defaultPref placement is applied on first launch.
 * Widget IDs: extension ID with non-alphanumeric/non-hyphen chars replaced by "_", lowercased.
 */
defaultPref("browser.uiCustomization.state", JSON.stringify({
  placements: {
    "widget-overflow-fixed-list": [],
    "unified-extensions-area": [],
    "nav-bar": [
      "back-button",
      "forward-button",
      "stop-reload-button",
      "customizableui-special-spring1",
      "vertical-spacer",
      "urlbar-container",
      "customizableui-special-spring2",
      "downloads-button",
      "fxa-toolbar-menu-button",
      "reset-pbm-toolbar-button",
      "unified-extensions-button",
      "ublock0_raymondhill_net-browser-action",
      "sponsorblocker_ajay_app-browser-action",
      "clearcache_michel_de_almeida-browser-action",
      "_446900e4-71c2-419f-a6a7-df9c091e268b_-browser-action"
    ],
    "toolbar-menubar": ["menubar-items"],
    "TabsToolbar": ["tabbrowser-tabs", "new-tab-button", "alltabs-button"],
    "vertical-tabs": [],
    "PersonalToolbar": ["personal-bookmarks"]
  }
}));
